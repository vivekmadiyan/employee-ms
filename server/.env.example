PORT=5000
DATABASE_URL=postgresql://postgres:your-password@127.0.0.1:5432/employee_management_system
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
CLIENT_URL=https://your-frontend-url.example
ALLOWED_ORIGINS=https://your-frontend-url.example
PGSSL=false
TRUST_PROXY=true

# Optional SMTP for real employee invitation emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=EmployeeMS <no-reply@example.com>
